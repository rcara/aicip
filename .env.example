DATABASE_URL=postgres://aicip:aicip@127.0.0.1:5432/aicip
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
AI_COACH_MODE=mock
# Real coach stays off until an operator sets a base URL, a model name, and a server-side key.
# No provider is chosen in this repository. http:// is accepted only for localhost.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=8000
AI_ACTOR_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=200
# Days a deletion journal and a closed account row are kept. Default 365.
ACCOUNT_RETENTION_DAYS=365
